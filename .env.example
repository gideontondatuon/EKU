# TEMPLATE SAJA. Salin ke .env.docker atau .env.production, isi secret acak.
# Jangan menyalin ke .env sebelum scripts/local_database.py: script membuat .env lokal aman.
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=GANTI_DENGAN_SECRET_ACAK_MINIMAL_50_KARAKTER_SEBELUM_MENJALANKAN
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=eku
POSTGRES_USER=eku
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_URLSAFE
# Untuk native lokal, scripts/local_database.py menulis URL loopback port 55432.
# Untuk production, isi DATABASE_URL sesuai kredensial dan lokasi DB yang disetujui.
DATABASE_URL=postgresql://eku:GANTI_DENGAN_PASSWORD_ACAK_URLSAFE@db:5432/eku
DATABASE_SSLMODE=prefer
PRIVATE_ROOT=/app/.private
TRUST_PROXY_SSL=0
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
# Bootstrap bersifat eksplisit. Jangan simpan password admin di template/repository.
EKU_ADMIN_USERNAME=
EKU_ADMIN_EMAIL=
EKU_ADMIN_PASSWORD=
# Production: lokasi absolut sertifikat/kunci di host, read-only ke container Nginx.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Default port hanya loopback; membuka jaringan harus mengikuti persetujuan TI.
EKU_HTTP_BIND=127.0.0.1
EKU_HTTPS_BIND=127.0.0.1
